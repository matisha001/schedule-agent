# 复制为 .env 并填入真实值
LLM_API_KEY=sk-your-real-key
# 手机号登录 token 签名密钥（生产环境必填，开发环境可缺省）
TOKEN_SECRET=change-me-to-a-long-random-string

# MCP 服务配置（app/mcp/server.py 从本项目根 .env 读取）
TOURNAMENT_API_BASE=http://localhost:8000
# 预置登录 token（可选；不填则 MCP 以游客身份访问，仅公开数据。
# 填登录接口返回的 token 后，MCP 按该用户角色（player/organizer/operator/super_admin）访问）
TOURNAMENT_API_TOKEN=